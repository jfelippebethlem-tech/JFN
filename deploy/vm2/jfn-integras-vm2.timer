[Unit]
Description=JFN — íntegras SEI na VM-2: de hora em hora, contínuo (dono 15/11/2026: "usar sempre todo nosso poder computacional")

[Timer]
# A rodada dura até 3 h (5 h de madrugada); com o serviço ativo o systemd ignora o disparo — na prática, uma rodada
# emenda na outra. O navegador continua um por vez (trava .vm2_sei.lock compartilhada com a varredura).
OnCalendar=hourly
Persistent=true

[Install]
WantedBy=timers.target
