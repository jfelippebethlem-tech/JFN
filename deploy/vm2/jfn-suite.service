[Unit]
Description=JFN — suite de testes na VM-2 (alivio de carga da VM-1; resultado por DELTA)

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/JFN-worker
Environment=PYTHONPATH=/home/ubuntu/JFN-worker
ExecStart=/bin/bash /home/ubuntu/JFN-worker/tools/vm2_suite.sh
# a VM tem 11 GB e o dono pediu teto de 10: a suite mediu pico de 8 GB
MemoryMax=10G
Nice=15
IOSchedulingClass=idle
