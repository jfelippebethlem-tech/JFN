bedrock:
  discovery:
    enabled: true
    provider_filter: []
    refresh_interval: 3600
  guardrail:
    guardrail_identifier: ''
    guardrail_version: ''
    stream_processing_mode: async
    trace: disabled
  region: ''
browser:
  allow_private_urls: false
  auto_local_for_private_urls: true
  camofox:
    adopt_existing_tab: false
    loopback_host_alias: host.docker.internal
    managed_persistence: false
    rewrite_loopback_urls: false
    session_key: ''
    user_id: ''
  cdp_url: http://127.0.0.1:9222
  command_timeout: 30
  dialog_policy: must_respond
  dialog_timeout_s: 300
  engine: auto
  inactivity_timeout: 1800
  record_sessions: false
checkpoints:
  auto_prune: true
  delete_orphans: true
  enabled: false
  max_file_size_mb: 10
  max_snapshots: 20
  max_total_size_mb: 500
  min_interval_hours: 24
  retention_days: 7
code_execution:
  max_tool_calls: 50
  mode: project
  timeout: 300
command_allowlist:
  - shell command via -c/-lc flag
  - script execution via -e/-c flag
  - hermes update (restarts gateway, kills running agents)
  - stop/restart system service
  - stop/restart hermes gateway (kills running agents)
compression:
  abort_on_summary_failure: false
  codex_gpt55_autoraise: true
  enabled: true
  hygiene_hard_message_limit: 400
  protect_first_n: 3
  protect_last_n: 20
  target_ratio: 0.2
  threshold: 0.5
context:
  engine: compressor
cron:
  wrap_response: true
curator:
  archive_after_days: 90
  backup:
    enabled: true
    keep: 5
  enabled: true
  interval_hours: 168
  min_idle_hours: 2
  prune_builtins: true
  stale_after_days: 30
dashboard:
  basic_auth:
    password: ''
    password_hash: ''
    secret: ''
    session_ttl_seconds: 0
    username: ''
  oauth:
    client_id: ''
    portal_url: ''
  public_url: ''
  show_token_analytics: false
  theme: default
delegation:
  api_key: ''
  api_mode: ''
  base_url: ''
  child_timeout_seconds: 600
  inherit_mcp_toolsets: true
  max_concurrent_children: 3
  max_iterations: 50
  max_spawn_depth: 1
  model: ''
  orchestrator_enabled: true
  provider: ''
  reasoning_effort: ''
  subagent_auto_approve: false
discord:
  allow_any_attachment: false
  allowed_channels: ''
  auto_thread: true
  dm_role_auth_guild: ''
  free_response_channels: ''
  history_backfill: true
  history_backfill_limit: 50
  max_attachment_bytes: 33554432
  reactions: true
  require_mention: true
  server_actions: ''
  thread_require_mention: false
  voice_fx:
    ack_enabled: true
    ack_phrases:
      - Let me look into that.
      - One moment.
      - Checking on that now.
      - Give me a sec.
      - On it.
    ambient_enabled: true
    ambient_gain: 0.18
    ambient_path: ''
    duck_gain: 0.06
    enabled: false
    speech_gain: 1.0
display:
  background_process_notifications: all
  bell_on_complete: false
  busy_ack_detail: true
  busy_input_mode: queue
  busy_text_mode: queue
  cleanup_progress: false
  compact: false
  copy_shortcut: auto
  ephemeral_system_ttl: 0
  file_mutation_verifier: true
  final_response_markdown: strip
  inline_diffs: true
  interface: cli
  interim_assistant_messages: false
  language: en
  long_running_notifications: true
  persistent_output: true
  persistent_output_max_lines: 200
  personality: concise
  platforms:
    discord:
      streaming: false
    telegram:
      streaming: false
  resume_display: full
  resume_exchanges: 10
  resume_max_assistant_chars: 200
  resume_max_assistant_lines: 3
  resume_max_user_chars: 300
  resume_skip_tool_only: true
  runtime_footer:
    enabled: false
    fields:
      - model
      - context_pct
      - cwd
  show_cost: false
  show_reasoning: false
  skin: default
  streaming: true
  timestamps: false
  tool_preview_length: 0
  tool_progress: none
  tool_progress_command: false
  tool_progress_overrides: {}
  tui_agents_nudge: true
  tui_auto_resume_recent: false
  tui_status_indicator: kaomoji
  turn_completion_explainer: true
  user_message_preview:
    first_lines: 2
    last_lines: 2
fallback_providers:
  # ── CADEIA AUDITADA E REORDENADA (2026-07-31) ────────────────────────────────
  # Cada degrau foi TESTADO com uma requisicao real. Dos 20 anteriores, 6 estavam
  # MORTOS e sairam: github-models/gpt-4o-mini (HTTP 410, servico APOSENTADO),
  # nvidia/llama-3.3-70b (ReadTimeout), openrouter/llama-3.3-70b:free (404
  # indisponivel), nous/inclusionai/ring-2.6-1t:free e nous/tencent/hy3-preview
  # (404, modelo inexistente) e aion/aion-1.0-mini (400, modelo desconhecido).
  # Entraram dois que respondem e estavam de fora: huggingface/Llama-3.3-70B (0,8s)
  # e groq/gpt-oss-120b (0,3s). Venice ficou FORA: HTTP 402, saldo insuficiente —
  # e paga (§4.1: nunca presumir que API paga nao cobra).
  #
  # A ORDEM segue os tres criterios da casa (medidos em incidentes reais), nao "forca bruta":
  #  1. JANELA — o catalogo do JFN sao ~18 mil tokens em TODA requisicao; quem nao
  #     comporta isso nao e fallback, e ida e volta perdida.
  #  2. VISAO PRIMEIRO — o dono manda FOTO. Cair num modelo so-texto nao da erro:
  #     da resposta errada, que e pior. Visao VERIFICADA no catalogo do provedor:
  #     gemini (1M) e stepfun/step-3.7-flash (262k, text+image+video).
  #  3. GROQ NO FIM, todos os modelos dela: o limite de 12.000 TPM e da CONTA, nao
  #     do modelo — foi o que causou o 413 em toda mensagem em 25/07.
  - base_url: https://generativelanguage.googleapis.com/v1beta
    model: gemini-2.5-flash
    provider: gemini
  - base_url: https://generativelanguage.googleapis.com/v1beta
    model: gemini-2.5-flash-lite
    provider: gemini
  - base_url: https://inference-api.nousresearch.com/v1
    model: stepfun/step-3.7-flash:free
    provider: nous
  - base_url: https://api.cohere.ai/compatibility/v1
    key_env: COHERE_API_KEY
    model: command-a-03-2025
    provider: cohere
  - base_url: https://api.mistral.ai/v1
    model: mistral-large-latest
    provider: mistral
  - base_url: https://api.cerebras.ai/v1
    key_env: CEREBRAS_API_KEY
    model: gpt-oss-120b
    provider: cerebras
  - base_url: https://api.sambanova.ai/v1
    key_env: SAMBANOVA_API_KEY
    model: Meta-Llama-3.3-70B-Instruct
    provider: sambanova
  - base_url: https://api.z.ai/api/paas/v4
    key_env: GLM_API_KEY
    model: glm-4.7-flash
    provider: zai
  - base_url: https://router.huggingface.co/v1
    key_env: HF_TOKEN
    model: meta-llama/Llama-3.3-70B-Instruct
    provider: huggingface
  - base_url: https://api.cloudflare.com/client/v4
    key_env: CLOUDFLARE_API_TOKEN
    model: '@cf/meta/llama-3.3-70b-instruct-fp8-fast'
    provider: cloudflare
  - base_url: https://api.mistral.ai/v1
    model: mistral-small-latest
    provider: mistral
  - base_url: https://api.reka.ai/v1
    key_env: REKA_API_KEY
    model: reka-flash
    provider: reka
  - base_url: https://api.siliconflow.com/v1
    key_env: SILICONFLOW_API_KEY
    model: Qwen/Qwen3-8B
    provider: siliconflow
  - base_url: https://api.groq.com/openai/v1
    model: openai/gpt-oss-120b
    provider: groq
  - base_url: https://api.groq.com/openai/v1
    model: llama-3.3-70b-versatile
    provider: groq
  - base_url: https://api.groq.com/openai/v1
    model: llama-3.1-8b-instant
    provider: groq
file_read_max_chars: 100000
gateway:
  media_delivery_allow_dirs: []
  strict: false
  trust_recent_files: true
  trust_recent_files_seconds: 600
goals:
  max_turns: 20
group_sessions_per_user: true
hooks_auto_accept: false
human_delay:
