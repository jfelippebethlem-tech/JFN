{
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.claude; [ -f ~/.claude/CLAUDE.md ] || cp /home/ubuntu/JFN/.claude/global_preferences.md ~/.claude/CLAUDE.md 2>/dev/null; true"
          }
        ]
      }
    ]
  }
}
